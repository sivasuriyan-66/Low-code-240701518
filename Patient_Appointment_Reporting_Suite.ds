 application "Patient Appointment Reporting Suite"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form appointment_booking
		{
			displayname = "Appointment Booking"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			appointment_id
			(
    			type = text
				displayname = "Appointment ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			patient
			(
				type = list	
				displayname = "Patient"
				values  = patient_profile.ID
    			displayformat = [patient_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			doctor
			(
				type = list	
				displayname = "Doctor"
				values  = doctor_profile.ID
    			displayformat = [doctor_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_appointment_date
			(
    			type = date
				displayname = "Preferred Appointment Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_appointment_time
			(
    			type = time
				displayname = "Preferred Appointment Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			appointment_status
			(
				type = picklist
				displayname = "Appointment Status"
				values = {"Requested","Checked-In","Consulted","Confirmed","Cancelled"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			check_in_status
			(
				type = picklist
				displayname = "Check In Status"
				values = {"Not Arrived","No Show","Checked In"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			consultation_status
			(
				type = picklist
				displayname = "Consultation Status"
				values = {"Completed","In Progress","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			payment_status
			(
				type = picklist
				displayname = "Payment Status"
				values = {"Paid","Pending","Partially Paid"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			appointment_submitted_on
			(
    			type = datetime
				displayname = "Appointment Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			department
			(
				type = picklist
				displayname = "Department"
				values = {"Neurology","Pediatrics","Dermatology","Orthopedics","Gynecology","Gastroenterology","General Medicine","ENT","Ophthalmology","Dentistry","Cardiology"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			notes
			(
    			type = textarea
				displayname = "Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form doctor_profile
		{
			displayname = "Doctor Profile"
			success message = "Doctor Profile Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			doctor_name
			(
    			type = name
				displayname = "Doctor Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			specialization
			(
				type = picklist
				displayname = "Specialization"
				values = {"Neurology","Pediatrics","Dermatology","Orthopedics","Gynecology","Gastroenterology","General Medicine","ENT","Ophthalmology","Dentistry","Cardiology"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			department
			(
				type = picklist
				displayname = "Department"
				values = {"Neurology","Pediatrics","Dermatology","Orthopedics","Gynecology","Gastroenterology","General Medicine","ENT","Ophthalmology","Dentistry","Cardiology"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			consultation_fee
			(
				displayname = "Consultation Fee"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			availability_status
			(
				type = picklist
				displayname = "Availability Status"
				values = {"On Leave","Available","Unavailable"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			license_number
			(
    			type = text
				displayname = "License Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			experience_years
			(
				type = number
				displayname = "Experience Years"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form patient_profile
		{
			displayname = "Patient Profile"
			success message = "Patient Profile Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			patient_name
			(
    			type = name
				displayname = "Patient Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			gender
			(
				type = picklist
				displayname = "Gender"
				values = {"Male","Female","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			residential_address
			(
    			type = address
				displayname = "Residential Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			date_of_birth
			(
    			type = date
				displayname = "Date Of Birth"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			emergency_contact
			(
    			type = name
				displayname = "Emergency Contact"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			emergency_phone
			(
    			type = phonenumber
				displayname = "Emergency Phone"
	 			row = 1
	 			column = 1   
				width = medium
			)
			insurance_provider
			(
    			type = text
				displayname = "Insurance Provider"
	 			row = 1
	 			column = 1   
				width = medium
			)
			insurance_id
			(
    			type = text
				displayname = "Insurance ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list appointment_booking_Report
		{
			displayName = "Appointment Booking Report"
			show all rows from appointment_booking    
			(
				appointment_id as "Appointment ID"
				patient as "Patient"
				doctor as "Doctor"
				preferred_appointment_date as "Preferred Appointment Date"
				preferred_appointment_time as "Preferred Appointment Time"
				appointment_status as "Appointment Status"
				check_in_status as "Check In Status"
				consultation_status as "Consultation Status"
				payment_status as "Payment Status"
				appointment_submitted_on as "Appointment Submitted On"
				department as "Department"
				notes as "Notes"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (appointment_status == "Confirmed")
				fields = [appointment_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (appointment_status == "Consulted")
				fields = [appointment_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (appointment_status == "Requested")
				fields = [appointment_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban appointment_booking_by_appointment_status
		{
			displayName = "Appointment Statuses"
			show all rows from appointment_booking    
			(
				appointment_id as "Appointment ID"
				patient as "Patient"
				doctor as "Doctor"
				preferred_appointment_date as "Preferred Appointment Date"
				preferred_appointment_time as "Preferred Appointment Time"
				appointment_status as "Appointment Status"
				check_in_status as "Check In Status"
				consultation_status as "Consultation Status"
				payment_status as "Payment Status"
				appointment_submitted_on as "Appointment Submitted On"
				department as "Department"
				notes as "Notes"
			)
			options
			(
	 			display field = appointment_status
	 		)
		}
		list doctor_profile_Report
		{
			displayName = "All Doctor Profiles"
			show all rows from doctor_profile    
			(
				doctor_name  as "Doctor Name"
				specialization as "Specialization"
				department as "Department"
				phone_number as "Phone Number"
				email as "Email"
				consultation_fee as "Consultation Fee"
				(
					display = total,average,min,max	
				)
				availability_status as "Availability Status"
				license_number as "License Number"
				experience_years as "Experience Years"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (availability_status == "Unavailable")
				fields = [availability_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
			)
		}
		kanban doctor_profile_by_availability_status
		{
			displayName = "Availability Statuses"
			show all rows from doctor_profile    
			(
				doctor_name  as "Doctor Name"
				specialization as "Specialization"
				department as "Department"
				phone_number as "Phone Number"
				email as "Email"
				consultation_fee as "Consultation Fee"
				(
					display = total,average,min,max	
				)
				availability_status as "Availability Status"
				license_number as "License Number"
				experience_years as "Experience Years"
			)
			options
			(
	 			display field = availability_status
	 		)
		}
		list patient_profile_Report
		{
			displayName = "All Patient Profiles"
			show all rows from patient_profile    
			(
				patient_name  as "Patient Name"
				residential_address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				gender as "Gender"
				phone_number as "Phone Number"
				emergency_contact  as "Emergency Contact"
				email as "Email"
				date_of_birth as "Date Of Birth"
				emergency_phone as "Emergency Phone"
				insurance_provider as "Insurance Provider"
				insurance_id as "Insurance ID"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (gender == "Female")
				fields = [gender]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (gender == "Male")
				fields = [gender]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (gender == "Other")
				fields = [gender]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban patient_profile_by_gender
		{
			displayName = "Genders"
			show all rows from patient_profile    
			(
				patient_name  as "Patient Name"
				residential_address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				gender as "Gender"
				phone_number as "Phone Number"
				emergency_contact  as "Emergency Contact"
				email as "Email"
				date_of_birth as "Date Of Birth"
				emergency_phone as "Emergency Phone"
				insurance_provider as "Insurance Provider"
				insurance_id as "Insurance ID"
			)
			options
			(
	 			display field = gender
	 		)
		}
	}
	pages
	{
		page DashBoard
		{

		workflow
		{
		form
		{
			validate_doctor_availability as "Validate Doctor Availability"
			{
				type =  form
				form = appointment_booking

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if a doctor is selected
										if(input.doctor != null && input.doctor.size() > 0)
										{
											// Iterate through selected doctors to check availability
											for each  doctorRecord in input.doctor
											{
												// Get the doctor profile record
												doctorProfile = doctor_profile[ID == doctorRecord.ID];
												// Check if the doctor's availability status is 'Unavailable'
												if(doctorProfile.availability_status == "Unavailable")
												{
													// Display alert message
													alert "The selected doctor is currently unavailable. Please choose another doctor or try again later.";
													// Cancel the form submission
													cancel submit;
												}
											}
										}
						)
					}
				}

			}
		}







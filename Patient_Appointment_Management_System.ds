		workflow
		{
		form
		{
			auto_calculate_net_fee as "Auto-Calculate Net Fee"
			{
				type =  form
				form = appointment_booking

				record event = on add or edit

				on user input of consultation_fee
				{
					actions 
					{
						custom deluge script
						(
											// Calculate net payable fee based on consultation fee and insurance coverage percentage
										consultationFee = input.consultation_fee;
										insuranceCoveragePercent = input.insurance_coverage_percent;
										// Validate that consultation fee is not null or empty
										if(consultationFee.isNull())
										{
											alert "Please enter a valid consultation fee";
											return;
										}
										// Validate that insurance coverage percent is not null or empty
										if(insuranceCoveragePercent.isNull())
										{
											alert "Please enter a valid insurance coverage percentage";
											return;
										}
										// Convert values to decimal for calculation
										consultationFeeDecimal = consultationFee.toDecimal();
										insuranceCoverageDecimal = insuranceCoveragePercent.toDecimal();
										// Calculate the insurance amount (consultation fee * insurance coverage percentage / 100)
										insuranceAmount = consultationFeeDecimal * insuranceCoverageDecimal / 100;
										// Calculate net payable fee (consultation fee - insurance amount)
										netPayableFee = consultationFeeDecimal - insuranceAmount;
										// Set the calculated net payable fee to the field
										input.net_payable_fee = netPayableFee;
										// Log the calculation details for debugging
										info "Consultation Fee: " + consultationFeeDecimal.toString();
										info "Insurance Coverage: " + insuranceCoverageDecimal.toString();
										info "Insurance Amount: " + insuranceAmount.toString();
										info "Net Payable Fee: " + netPayableFee.toString();
						)
					}
				}

			}
			validate_ambulance_requirement as "Validate Ambulance Requirement"
			{
				type =  form
				form = appointment_booking

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if ambulance pickup is required
										if(input.requires_ambulance_pickup == "Yes")
										{
											// Check if pickup details exist (using symptom_voice_note or symptom_video as placeholder for pickup details)
											// Since no specific pickup details field exists, we check if any relevant field has value
											// Assuming pickup details might be in symptom_voice_note or symptom_video or a dedicated field
											// For this example, checking if symptom_voice_note is empty as a proxy for missing pickup details
											if(input.symptom_voice_note.isBlank() && input.symptom_video.isBlank())
											{
												alert "Ambulance pickup is required but no pickup details have been provided. Please provide the necessary details before submitting.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			notify_doctor_new_booking as "Notify Doctor of New Booking"
			{
				type =  form
				form = appointment_booking

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the doctor record using the lookup field from the appointment booking
										if(input.doctor_availability_lookup.isNull() == false)
										{
											doctorRecord = doctors_master[ID == input.doctor_availability_lookup];
											// Check if doctor email is available
											if(doctorRecord.doctor_contact_number.isNull() == false)
											{
												// Send email notification to the doctor
												sendmail
												[
													from :zoho.loginuserid
													to :doctorRecord.doctor_contact_number
													subject :"New Appointment Booking Notification"
													message :"A new appointment has been booked. Please check your appointment schedule."
												]
											}
										}
						)
					}
				}

			}
		}

		schedule
		{
			daily_availability_check as "Daily Availability Check"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch all appointments where the preferred doctor is now unavailable
										unavailableDoctors = doctors_master[availability_status == "Unavailable"];
										for each  doctor in unavailableDoctors
										{
											// Get the doctor's full name
											doctorName = doctor.doctor_name.first_name.concat(" ").concat(doctor.doctor_name.last_name);
											// Fetch all appointments for this doctor
											patientAppointments = appointment_booking[doctor_availability_lookup.ID == doctor.ID];
											if(patientAppointments.count() > 0)
											{
												for each  appointment in patientAppointments
												{
													// Get patient email from the appointment record
													patientEmail = appointment.Added_User.email;
													// Check if patient email is valid
													if(!patientEmail.isNull() && !patientEmail.isEmpty())
													{
														// Send notification email to the patient
														sendmail
														[
															from :zoho.loginuserid
															to :patientEmail
															subject :"Important Update: Your Doctor's Availability Changed"
															message :"Dear Patient,\n\nWe would like to inform you that your preferred doctor, " + doctorName + ", is currently unavailable.\n\nPlease contact our clinic to reschedule your appointment.\n\nThank you for your understanding.\n\nBest regards,\nPatient Appointment Management System"
														]
													}
												}
											}
										}
					)
					}
				}
			}
		}



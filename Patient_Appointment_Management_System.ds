 application "Patient Appointment Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form appointment_booking
		{
			displayname = "Appointment Booking"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			appointment_submitted_on
			(
    			type = datetime
				displayname = "Appointment Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			patient_photo
			(
    			type = text
				displayname = "Patient Photo"
	 			row = 1
	 			column = 1   
				width = medium
			)
			previous_medical_report
			(
    			type = text
				displayname = "Previous Medical Report"
	 			row = 1
	 			column = 1   
				width = medium
			)
			body_temperature_f
			(
    			type = text
				displayname = "Body Temperature"
	 			row = 1
	 			column = 1   
				width = medium
			)
			accompanying_family_members
			(
    			type = text
				displayname = "Accompanying Family Members"
	 			row = 1
	 			column = 1   
				width = medium
			)
			previous_report_portal_url
			(
    			type = url
				displayname = "Previous Report Portal URL"
	 			row = 1
	 			column = 1   
				width = medium
			)
			symptom_video
			(
    			type = text
				displayname = "Symptom Video"
	 			row = 1
	 			column = 1   
				width = medium
			)
			symptom_voice_note
			(
    			type = text
				displayname = "Symptom Voice Note"
	 			row = 1
	 			column = 1   
				width = medium
			)
			requires_ambulance_pickup
			(
				type = radiobuttons
				displayname = "Requires Ambulance Pickup"
				values = {"No","Yes"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			consultation_fee
			(
				displayname = "Consultation Fee"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			insurance_coverage_percent
			(
    			type = percentage
				displayname = "Insurance Coverage Percent"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			net_payable_fee
			(
				type = decimal
				displayname = "Net Payable Fee"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			clinic_guidelines_display
			(
    			type = textarea
				displayname = "Clinic Guidelines Display"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			patient_digital_signature
			(
    			type = text
				displayname = "Patient Digital Signature"
	 			row = 1
	 			column = 1   
				width = medium
			)
			appointment_qr_code
			(
    			type = text
				displayname = "Appointment QR Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			doctor_availability_lookup
			(
				type = picklist	
				displayname = "Doctor Availability"
				values  = doctors_master.ID
    			displayformat = [doctor_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Appointment Request Received","Doctor Availability Check","Appointment Rejected","Appointment Scheduled","Appointment Pending Review","Appointment Confirmed","Appointment Rescheduled","Appointment Cancelled","Appointment In Progress","Consultation Completed","Appointment On Hold","Appointment Closed"}
			}
		}
		form doctors_master
		{
			displayname = "Doctors Master"
			success message = "Doctors Master Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			doctor_name
			(
    			type = name
				displayname = "Doctor Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			specialization
			(
				type = picklist
				displayname = "Specialization"
				values = {"Neurology","Pediatrics","Orthopedics","General Medicine","Cardiology"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			available_time_slots
			(
				type = list	
				displayname = "Available Time Slots"
				values = {"5 PM-8 PM","2 PM-5 PM","10 AM-1 PM","9 AM-12 PM"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			consultation_fee
			(
				displayname = "Consultation Fee"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			doctor_contact_number
			(
    			type = phonenumber
				displayname = "Doctor Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			availability_status
			(
				type = radiobuttons
				displayname = "Availability Status"
				values = {"Available","Unavailable"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list appointment_booking_Report
		{
			displayName = "Appointment Booking Report"
			show all rows from appointment_booking    
			(
				appointment_submitted_on as "Appointment Submitted On"
				patient_photo as "Patient Photo"
				previous_medical_report as "Previous Medical Report"
				body_temperature_f as "Body Temperature"
				accompanying_family_members as "Accompanying Family Members"
				previous_report_portal_url as "Previous Report Portal URL"
				symptom_video as "Symptom Video"
				symptom_voice_note as "Symptom Voice Note"
				requires_ambulance_pickup as "Requires Ambulance Pickup"
				consultation_fee as "Consultation Fee"
				(
					display = total,average,min,max	
				)
				insurance_coverage_percent as "Insurance Coverage Percent"
				(
					display = total,average,min,max	
				)
				net_payable_fee as "Net Payable Fee"
				clinic_guidelines_display as "Clinic Guidelines Display"
				patient_digital_signature as "Patient Digital Signature"
				appointment_qr_code as "Appointment QR Code"
				doctor_availability_lookup as "Doctor Availability"
			)
		}
		list doctors_master_Report
		{
			displayName = "All Doctors Masters"
			show all rows from doctors_master    
			(
				doctor_name  as "Doctor Name"
				specialization as "Specialization"
				available_time_slots as "Available Time Slots"
				consultation_fee as "Consultation Fee"
				(
					display = total,average,min,max	
				)
				doctor_contact_number as "Doctor Contact Number"
				availability_status as "Availability Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (specialization == "Neurology")
				fields = [specialization]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (specialization == "Orthopedics")
				fields = [specialization]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (specialization == "Pediatrics")
				fields = [specialization]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban doctors_master_by_specialization
		{
			displayName = "Specializations"
			show all rows from doctors_master    
			(
				doctor_name  as "Doctor Name"
				specialization as "Specialization"
				available_time_slots as "Available Time Slots"
				consultation_fee as "Consultation Fee"
				(
					display = total,average,min,max	
				)
				doctor_contact_number as "Doctor Contact Number"
				availability_status as "Availability Status"
			)
			options
			(
	 			display field = specialization
	 		)
		}
	}

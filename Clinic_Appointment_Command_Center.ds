				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_checked_in
			(
    			type = checkbox
				displayname = "Is Checked In"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			notes
			(
    			type = textarea
				displayname = "Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Walk-In Registered","Triage Assessment","Registration Error","Priority High","Priority Medium","Priority Low","Emergency Escalation","Doctor Assigned","Emergency Room","Patient Checked In","Consultation In Progress","Treatment Plan Created","Referral Required","Patient Discharged","Admission Required","Inpatient Registration","Process Completed"}
			}
		}
	}
	reports
	{
		list appointment_record_Report
		{
			displayName = "All Appointment Records"
			show all rows from appointment_record    
			(
				appointment_id as "Appointment ID"
				patient_name  as "Patient Name"
				contact_number as "Contact Number"
				email_address as "Email Address"
				department as "Department"
				preferred_date as "Preferred Date"
				preferred_time as "Preferred Time"
				appointment_status as "Appointment Status"
				doctor_assigned as "Doctor Assigned"
				net_payable_fee as "Net Payable Fee"

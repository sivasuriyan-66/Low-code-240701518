 \n\t\n>\n\t<text \n    action = 'OpenForm'\n\t\tcomponentLinkName = 'walk_in_registration'\n\t\ttarget = 'new-window'\n\n\tcolor = '#6733AB'\n\tsize = '15px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Add New Walk In Registration'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel_Button 4'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tbgColor = '#8A3DFB'\n\n\t\twidth = '2%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t\n</pc>\n</pr>\n</pc><pc \n\t\tpaddingTop = '10px'\n\tpaddingLeft = '10px'\n\tpaddingRight = '0px'\n\tpaddingBottom = '10px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '98%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginRight = '10px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\n\tcolor = '#2C0D4A'\n\tbgColor = '#F4F0FF'\n\twidth = '36px'\n\theight = '36px'\n\ttype = 'icon'\n\tvalue = 'ui-2-square-add-08'\n\tsize = '16px'\n\tcornerRadius = '18px'\n\ticonType = 'outline'\n/>\n</pc><pc \n\t\n>\n\t<text \n    action = 'OpenForm'\n\t\tcomponentLinkName = 'department_load'\n\t\ttarget = 'new-window'\n\n\tcolor = '#6733AB'\n\tsize = '15px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Add New Department Load'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row>\n</column>\n</row><row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Chart 1'\n\n\t\n\ttitle = 'Distribution by Blood Group'\n\t\n\t\ttitleSize = '15px'\n\ttype = 'Column'\n\txtitle = 'Blood Group'\n\tytitle = 'Count of Blood Group'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme'\n\tlegendPos = 'none'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'patient_profile'\n\txfield = 'blood_group'\n\tyfields = 'count:blood_group'\n\tgroupBy = 'patient_id'\n\t\tDelugeCriteria = 'blood_group is not null &amp;&amp; blood_group != &quot;&quot;'\n/>\n\n</column><column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Chart 2'\n\n\t\n\ttitle = 'Distribution by Last Modified By'\n\t\n\t\ttitleSize = '15px'\n\ttype = 'Bar'\n\txtitle = 'Last Modified By'\n\tytitle = 'Count of Last Modified By'\n\tbgColor = '#FFFFFF'\n\ttheme = '#198391'\n\tlegendPos = 'none'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'clinic_guidelines'\n\txfield = 'last_modified_by'\n\tyfields = 'count:last_modified_by'\n\tgroupBy = 'guideline_id'\n\t\tDelugeCriteria = 'last_modified_by is not null &amp;&amp; last_modified_by != &quot;&quot;'\n/>\n\n</column>\n</row>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'appointment_record_Report'\n\t\n\t\tiszreport = 'false'\n\t\t\t\t\tzc_AddRec = 'false'\n\t\t\t\t\tzc_EditRec = 'false'\n\t\t\t\t\tzc_Print = 'false'\n\t\t\t\t\tzc_Export = 'false'\n\t\t\t\t\tzc_DelRec = 'false'\n\t\t\t\t\tzc_DuplRec = 'false'\n\t\t\t\t\tzc_Search = 'false'\n\t\t\t\t\tzc_EditBulkRec = 'false'\n\t\t\t\t\tzc_BulkDelete = 'false'\n\t\t\t\t\tzc_BulkDuplicate = 'false'\n\theightType = 'custom'\n\theightValue = '500'\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}




		workflow
		{
		form
		{
			auto_confirm_appointment as "Auto-Confirm Appointment"
			{
				type =  form
				form = appointment_record

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Update the appointment status to Confirmed
										input.appointment_status = "Confirmed";
										// Prepare the notification message
										patientName = input.patient_name.first_name.concat(" ").concat(input.patient_name.last_name);
										message = "Dear " + patientName + ",\n\nYour appointment has been successfully confirmed.\n\nPlease find the details below:\nDoctor: " + input.doctor_assigned.doctor_name + "\nDepartment: " + input.department + "\nDate: " + input.preferred_date.toString() + "\nTime: " + input.preferred_time.toString();
										// Send confirmation email to the patient
										sendmail
										[
											from :zoho.loginuserid
											to :input.email_address
											subject :"Appointment Confirmed"
											message :message
											content type :HTML
										]
						)
					}
				}

			}
		}

		schedule
		{
			pre_visit_reminder as "Pre-Visit Reminder"
			{
				type =  schedule
				form = appointment_record
					status = inactive
				start = preferred_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Calculate the reminder date (24 hours before preferred_date)
										reminderDateTime = input.preferred_date.addHour(-24);
										// Get current date-time for comparison
										currentDateTime = now;
										// Check if the appointment is scheduled for tomorrow (24 hours from now)
										if(currentDateTime >= reminderDateTime && currentDateTime < input.preferred_date)
										{
											// Prepare email message
											patientName = input.patient_name.first_name.concat(" ").concat(input.patient_name.last_name);
											doctorName = input.doctor_assigned.doctor_name;
											departmentName = input.department;
											emailSubject = "Appointment Reminder: " + patientName;
											emailMessage = "<p>Dear " + patientName + ",</p>" + "<p>This is a reminder that you have an appointment scheduled for tomorrow.</p>" + "<p><strong>Appointment Details:</strong></p>" + "<ul>" + "<li><strong>Date:</strong> " + input.preferred_date.toString() + "</li>" + "<li><strong>Department:</strong> " + departmentName + "</li>" + "<li><strong>Doctor:</strong> " + doctorName + "</li>" + "</ul>" + "<p>Please arrive 15 minutes before your scheduled time.</p>" + "<p>Thank you,</p>" + "<p>Clinic Appointment Command Center</p>";
											// Send email to patient
											sendmail
											[
												from :zoho.loginuserid
												to :input.email_address
												subject :emailSubject
												message :emailMessage
												content type :HTML
											]
										}
					)
					}
				}
			}
		}



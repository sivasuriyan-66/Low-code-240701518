 application "Clinic Appointment Command Center"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form appointment_lookup
		{
			displayname = "Appointment Lookup"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			lookup_id
			(
    			type = text
				displayname = "Lookup ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			source_appointment
			(
				type = picklist	
				displayname = "Source Appointment"
				values  = appointment_record.ID
    			displayformat = [appointment_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			lookup_type
			(
				type = picklist
				displayname = "Lookup Type"
				values = {"Reminder","Board","Report","Viewer"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_date
			(
    			type = date
				displayname = "Created Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = radiobuttons
				displayname = "Status"
				values = {"Active","Archived"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			notes
			(
    			type = textarea
				displayname = "Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form appointment_record
		{
			displayname = "Appointment Record"
			success message = "Appointment Record Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			appointment_id
			(
    			type = text
				displayname = "Appointment ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			patient_name
			(
    			type = name
				displayname = "Patient Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			email_address
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			department
			(
				type = picklist
				displayname = "Department"
				values = {"Pediatrics","Neurology","Orthopedics","General Medicine","Cardiology"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_date
			(
    			type = date
				displayname = "Preferred Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_time
			(
    			type = time
				displayname = "Preferred Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			appointment_status
			(
				type = picklist
				displayname = "Appointment Status"
				values = {"Requested","Checked-In","Consulted","Confirmed","Cancelled"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			doctor_assigned
			(
				type = picklist	
				displayname = "Doctor Assigned"
				values  = doctor_master.ID
    			displayformat = [doctor_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			net_payable_fee
			(
				displayname = "Net Payable Fee"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			medical_report_link
			(
    			type = url
				displayname = "Medical Report Link"
	 			row = 1
	 			column = 1   
				width = medium
			)
			consent_signed
			(
    			type = checkbox
				displayname = "Consent Signed"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Appointment Requested","Appointment Scheduled","Appointment Cancelled","Appointment Confirmed","Appointment Rescheduled","Appointment In Progress","Appointment Completed","Appointment On Hold","Appointment Closed","Appointment Follow-up Required"}
			}
		}

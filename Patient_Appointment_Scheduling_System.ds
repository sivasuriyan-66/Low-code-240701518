n\t\n\ttitle = 'Distribution by Assigned Staff'\n\t\n\ttype = 'Bar'\n\txtitle = 'Assigned Staff'\n\tytitle = 'Count of Assigned Staff'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme'\n\tlegendPos = 'none'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'appointment_record'\n\txfield = 'assigned_staff'\n\tyfields = 'count:assigned_staff'\n\tgroupBy = 'department'\n\t\tDelugeCriteria = 'assigned_staff is not null &amp;&amp; assigned_staff != &quot;&quot;'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'appointment_record_Report'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row>\n</layout>\n</zml>"

		workflow
		{
		form
		{
			auto_confirm_appointment as "Auto-Confirm Appointment"
			{
				type =  form
				form = appointment_record

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the current appointment record
										appointmentRecord = appointment_record[ID == input.ID];
										// Update the confirmation_status field to Confirmed
										appointmentRecord.confirmation_status="Confirmed";
										// Get the patient's email address from the patient profile lookup
										patientRecord = patient_profile[ID == input.patient];
										patientEmail = patientRecord.email_address;
										// Check if patient email is valid before sending email
										if(!patientEmail.isNull())
										{
											// Send confirmation email to the patient
											sendmail
											[
												from :zoho.loginuserid
												to :patientEmail
												subject :"Appointment Confirmed"
												message :"Your appointment has been confirmed. We look forward to seeing you."
											]
										}
										// Send confirmation email to the assigned staff if available
										if(!input.assigned_staff.isNull())
										{
											// Get staff email from department master or use login user as fallback
											staffEmail = zoho.loginuserid;
											sendmail
											[
												from :zoho.loginuserid
												to :staffEmail
												subject :"New Appointment Assigned"
												message :"You have been assigned a new appointment. Please review the details."
											]
										}
										// Display success message
										success message "Appointment confirmed and notifications sent successfully";
						)
					}
				}

			}
			notify_staff_urgent as "Notify Staff of Urgent Cases"
			{
				type =  form
				form = appointment_record

				record event = on edit

				on user input of priority_level
				{
					actions 
					{
						custom deluge script
						(
											// Fetch urgent priority appointments where assigned_staff is not empty
										urgentAppointments = appointment_record[priority_level == "Urgent" && assigned_staff != ""];
										// Iterate through each urgent appointment to send notifications
										for each  appointment in urgentAppointments
										{
											// Get the assigned staff email from the assigned_staff field
											staffEmail = appointment.assigned_staff;
											// Validate that staff email is not null or empty
											if(staffEmail.isNull() || staffEmail.isEmpty())
											{
												continue;
											}
											// Get patient name from the appointment
											patientName = appointment.patient_name;
											// Get department name
											departmentName = appointment.department_name;
											// Get appointment reference
											appointmentRef = appointment.appointment_reference;
											// Send notification email to assigned staff
											sendmail
											[
												from :zoho.loginuserid
												to :staffEmail
												subject :"Urgent Appointment Notification - " + patientName
												message :"Dear Staff,\n\nYou have an urgent appointment scheduled.\n\nPatient Name: " + patientName + "\nDepartment: " + departmentName + "\nAppointment Reference: " + appointmentRef + "\n\nPlease attend to this appointment as soon as possible.\n\nThank you."
											]
										}
						)
					}
				}

			}
		}





 * Version      : 1.0
 */
 application "Patient Appointment Scheduling System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form appointment_record
		{
			displayname = "Appointment Record"
			success message = "Appointment Record Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			department
			(
				type = list	
				displayname = "Department"
				values  = department_master.ID
    			displayformat = [department_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			patient
			(
				type = list	
				displayname = "Patient"
				values  = patient_profile.ID
    			displayformat = [patient_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			appointment_reference
			(
    			type = text
				displayname = "Appointment Reference"
	 			row = 1
	 			column = 1   
				width = medium
			)
			confirmation_status
			(
				type = picklist
				displayname = "Confirmation Status"
				values = {"Unconfirmed","Confirmed","Rescheduled"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			assigned_staff
			(
    			type = text
				displayname = "Assigned Staff"
	 			row = 1
	 			column = 1   
				width = medium
			)
			notes
			(
    			type = text
				displayname = "Notes"
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_updated
			(
    			type = datetime
				displayname = "Last Updated"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			priority_level
			(
				type = picklist
				displayname = "Priority Level"
				values = {"High","Urgent","Low","Medium"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			department_name
			(
    			type = text
				displayname = "Department Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			patient_name
			(
    			type = text
				displayname = "Patient Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Appointment Requested","Appointment Pending Review","Appointment Cancelled","Appointment Scheduled","Appointment Rescheduled","Appointment Confirmed","Appointment In Progress","Appointment Completed","Appointment On Hold","Appointment Closed","Appointment Follow-up Required"}
			}
		}
		form department_master
		{
			displayname = "Department Master"
			success message = "Department Master Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			department_name
			(
    			type = text
				displayname = "Department Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			department_code
			(
    			type = text
				displayname = "Department Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			head_of_department
			(
    			type = name
				displayname = "Head of Department"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_email
			(
    			type = email
				displayname = "Contact Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_phone
			(
    			type = phonenumber
				displayname = "Contact Phone"
	 			row = 1
	 			column = 1   
				width = medium
			)
			operating_hours
			(
    			type = text
				displayname = "Operating Hours"
	 			row = 1
	 			column = 1   
				width = medium
			)
			location
			(
    			type = text
				displayname = "Location"
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			description
			(
    			type = textarea
				displayname = "Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_date
			(
    			type = date
				displayname = "Created Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form patient_profile
		{
			displayname = "Patient Profile"
			success message = "Patient Profile Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			patient_name
			(
    			type = name
				displayname = "Patient Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			gender
			(
				type = picklist
				displayname = "Gender"
				values = {"Male","Female","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			email_address
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			residential_address
			(
    			type = address
				displayname = "Residential Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			referred_by
			(
    			type = text
				displayname = "Referred By"
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_appointment_date
			(
    			type = date
				displayname = "Preferred Appointment Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_appointment_time
			(
    			type = time
				displayname = "Preferred Appointment Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			consent_for_treatment
			(
    			type = checkbox
				displayname = "Consent For Treatment"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_date
			(
    			type = date
				displayname = "Created Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Confirmed","Cancelled","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Profile Initiated","Details Pending Review","Consent Pending","Profile Rejected","Appointment Scheduled","Onboarding Complete","Appointment Rescheduled"}
			}
		}
	}
	reports
	{
		list appointment_record_Report
		{
			displayName = "All Appointment Records"
			show all rows from appointment_record    
			(
				department as "Department"
				patient as "Patient"
				appointment_reference as "Appointment Reference"
				confirmation_status as "Confirmation Status"
				assigned_staff as "Assigned Staff"
				notes as "Notes"
				last_updated as "Last Updated"
				priority_level as "Priority Level"
				department_name as "Department Name"
				patient_name as "Patient Name"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (priority_level == "High")
				fields = [priority_level]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (priority_level == "Medium")
				fields = [priority_level]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (priority_level == "Urgent")
				fields = [priority_level]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban appointment_record_by_priority_level
		{
			displayName = "Priority Levels"
			show all rows from appointment_record    
			(
				department as "Department"
				patient as "Patient"
				appointment_reference as "Appointment Reference"
				confirmation_status as "Confirmation Status"
				assigned_staff as "Assigned Staff"
				notes as "Notes"
				last_updated as "Last Updated"
				priority_level as "Priority Level"
				department_name as "Department Name"
				patient_name as "Patient Name"
			)
			options
			(
	 			display field = priority_level
	 		)
		}
		list patient_profile_Report
		{
			displayName = "All Patient Profiles"
			show all rows from patient_profile    
			(
				patient_name  as "Patient Name"
				gender as "Gender"
				email_address as "Email Address"
				contact_number as "Contact Number"
				residential_address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				referred_by as "Referred By"
				preferred_appointment_date as "Preferred Appointment Date"
				preferred_appointment_time as "Preferred Appointment Time"
				consent_for_treatment as "Consent For Treatment"
				created_date as "Created Date"
				status as "Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (gender == "Female")
				fields = [gender]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (gender == "Male")
				fields = [gender]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (gender == "Other")
				fields = [gender]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban patient_profile_by_gender
		{
			displayName = "Genders"
			show all rows from patient_profile    
			(
				patient_name  as "Patient Name"
				gender as "Gender"
				email_address as "Email Address"
				contact_number as "Contact Number"
				residential_address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				referred_by as "Referred By"
				preferred_appointment_date as "Preferred Appointment Date"
				preferred_appointment_time as "Preferred Appointment Time"
				consent_for_treatment as "Consent For Treatment"
				created_date as "Created Date"
				status as "Status"
			)
			options
			(
	 			display field = gender
	 		)
		}
		list department_master_Report
		{
			displayName = "All Department Masters"
			show all rows from department_master    
			(
				department_name as "Department Name"
				department_code as "Department Code"
				head_of_department  as "Head of Department"
				contact_email as "Contact Email"
				contact_phone as "Contact Phone"
				operating_hours as "Operating Hours"
				location as "Location"
				is_active as "Is Active"
				description as "Description"
				created_date as "Created Date"
			)
		}
	}
	pages
	{
		page DashBoard
		{
			displayname = "Dashboard"

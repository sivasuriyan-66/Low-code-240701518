 application "Patient Appointment Automation Suite"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form appointment_log
		{
			displayname = "Appointment Log"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			appointment
			(
				type = list	
				displayname = "Appointment"
				values  = appointment_record.ID
    			displayformat = [appointment_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			log_date
			(
    			type = datetime
				displayname = "Log Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			log_type
			(
				type = picklist
				displayname = "Log Type"
				values = {"Payment","Reminder","Submission","Status Change","Error","Approval"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			log_message
			(
    			type = textarea
				displayname = "Log Message"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			performed_by
			(
    			type = name
				displayname = "Performed By"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_success
			(
    			type = checkbox
				displayname = "Is Success"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			error_details
			(
    			type = textarea
				displayname = "Error Details"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			metadata
			(
    			type = textarea
				displayname = "Metadata"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form appointment_record
		{
			displayname = "Appointment Record"
			success message = "Appointment Record Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			appointment_id
			(
    			type = autonumber
				displayname = "Appointment ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			patient_name
			(
    			type = name
				displayname = "Patient Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"

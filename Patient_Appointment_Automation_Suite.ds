				{
				condition = (department == "General")
				fields = [department]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (department == "Neurology")
				fields = [department]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (department == "Orthopedics")
				fields = [department]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (department == "Pediatrics")
				fields = [department]
				format = "color:#ffffff;background-color:#3598db;"
				}
			)
		}

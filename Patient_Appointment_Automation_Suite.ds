			preferred_date
			(
    			type = date
				displayname = "Preferred Appointment Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_time
			(
    			type = time
				displayname = "Preferred Appointment Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			doctor_name
			(
    			type = name
				displayname = "Doctor Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			department
			(
				type = picklist
				displayname = "Department"
				values = {"Neurology","Pediatrics","Orthopedics","General","Cardiology"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			appointment_type
			(
				type = picklist
				displayname = "Appointment Type"
				values = {"Special Procedure","Routine","Follow Up"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			pre_visit_instructions
			(
    			type = textarea
				displayname = "Pre Visit Instructions"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			special_procedure
			(
    			type = checkbox
				displayname = "Special Procedure Requested"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			approval_status
			(
				type = picklist
				displayname = "Approval Status"
				values = {"Approved","Rejected","Rescheduled","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			approval_comments
			(
    			type = textarea
				displayname = "Approval Comments"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			approved_by
			(
    			type = name
				displayname = "Approved By"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			approval_date
			(
    			type = date
				displayname = "Approval Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			consultation_fee
			(
				displayname = "Consultation Fee"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			insurance_coverage
			(
    			type = percentage
				displayname = "Insurance Coverage Percent"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			net_payable_fee
			(
				displayname = "Net Payable Fee"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			payment_status
			(
				type = picklist
				displayname = "Payment Status"
				values = {"Failed","Paid","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			payment_reference
			(
    			type = text
				displayname = "Payment Transaction Reference"
	 			row = 1
	 			column = 1   
				width = medium
			)
			payment_link
			(
    			type = url
				displayname = "Payment Link"
	 			row = 1
	 			column = 1   
				width = medium
			)
			payment_failure_reason
			(
    			type = textarea
				displayname = "Payment Failure Reason"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			appointment_status
			(
				type = picklist
				displayname = "Status"
				values = {"Requested","Checked-In","Consulted","Pending Doctor Approval","Confirmed","Cancelled"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			check_in_status
			(
				type = radiobuttons
				displayname = "Check In Status"
				values = {"Checked In","Not Checked In"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			consultation_status
			(
				type = picklist
				displayname = "Consultation Status"
				values = {"Not Started","Completed","In Progress"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			status_change_comments
			(
    			type = textarea
				displayname = "Status Change Comments"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			follow_up_required
			(
    			type = checkbox
				displayname = "Follow Up Required"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			recommended_follow_up
			(
    			type = date
				displayname = "Recommended Follow Up Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			follow_up_reminder_sent
			(
    			type = checkbox
				displayname = "Follow Up Reminder Sent"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			visit_summary_generated
			(
    			type = checkbox
				displayname = "Visit Summary Generated"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			visit_summary_file
			(
    			type = url
				displayname = "Visit Summary File"
	 			row = 1
	 			column = 1   
				width = medium
			)
			visit_summary_sent_date
			(
    			type = datetime
				displayname = "Visit Summary Sent Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			appointment_reminder_sent
			(
    			type = checkbox
				displayname = "Appointment Reminder Sent"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Appointment Requested","Pending Doctor Approval","Appointment Cancelled","Appointment Approved","Appointment Rejected","Appointment Scheduled","Pre-Visit Instructions Sent","Appointment Rescheduled","Patient Checked In","Consultation In Progress","Consultation Completed","Payment Pending","Visit Summary Generated","Payment Completed","Payment Failed","Follow Up Required","Visit Summary Sent","Appointment Closed","Follow Up Reminder Sent"}
			}
		}

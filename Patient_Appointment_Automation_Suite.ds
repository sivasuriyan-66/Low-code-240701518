		workflow
		{
		form
		{
			auto_set_net_payable_fee as "Auto-Set Net Payable Fee"
			{
				type =  form
				form = appointment_record

				record event = on add or edit

				on user input of consultation_fee
				{
					actions 
					{
						custom deluge script
						(
											// Get the consultation fee value
										consultationFee = input.consultation_fee;
										// Get the insurance coverage percentage
										insuranceCoverage = input.insurance_coverage;
										// Check if consultation fee is valid
										if(!consultationFee.isNull())
										{
											// Check if insurance coverage is valid
											if(!insuranceCoverage.isNull())
											{
												// Calculate the insurance amount
												insuranceAmount = consultationFee * insuranceCoverage / 100;
												// Calculate net payable fee
												netPayableFee = consultationFee - insuranceAmount;
												// Set the net payable fee value
												input.net_payable_fee = netPayableFee;
											}
											else
											{
												// If no insurance coverage, set net payable fee equal to consultation fee
												input.net_payable_fee = consultationFee;
											}
										}
						)
					}
				}

			}
			validate_appointment_date as "Validate Appointment Date"
			{
				type =  form
				form = appointment_record

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if preferred_date field is null or empty
										if(input.preferred_date.isNull())
										{
											// No date provided, allow submission
										}
										else
										{
											// Get the current date
											currentDate = today;
											// Compare preferred date with current date
											if(input.preferred_date < currentDate)
											{
												// Preferred date is in the past, show error and cancel submission
												alert "Error: Preferred date cannot be in the past. Please select a future date.";
												cancel submit;
											}
										}
						)
					}
				}

			}
		}






	}
	share_settings
	{
			"Read"
			{
				name = "Read"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have read permission for all components\n"
			}
			"Write"
			{
				name = "Write"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have write permission for all components\n"
			}
			"Developer"
			{
				name = "Developer"
				type = Developer
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Developer Profile\n"
			}
			"Administrator"
			{
				name = "Administrator"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have all the permissions.\n"
			}
			"Patient"
			{
				name = "Patient"
				type = Customer_Portal
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Submit appointment requests with preferred dates and special procedure needs \n"
				ModulePermissions
				{
					appointment_record
					{
						enabled= Create,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							appointment_record_by_appointment_status={"View"}
							appointment_record_Report={"View"}
						}
					}
				}
			}
			"Doctor"
			{
				name = "Doctor"
				type = Customer_Portal
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "View assigned appointments and update consultation status in real time \n"
				ModulePermissions
				{
					appointment_log
					{
						enabled= Viewall 
						allFieldsVisible= true 
						ReportPermissions
						{
							appointment_log_by_log_type={"View"}
							appointment_log_Report={"View"}
						}
					}
					appointment_record
					{
						allFieldsVisible= true 
						ReportPermissions
						{
							appointment_record_by_appointment_status={"View","Edit"}
							appointment_record_Report={"View","Edit"}
						}
					}
					doctor_profile
					{
						enabled= Viewall,Modifyall 
						allFieldsVisible= true 
						ReportPermissions
						{
							doctor_profile_Report={"View","Edit","Delete"}
							doctor_profile_by_specialization={"View","Edit","Delete"}
						}
					}
				}
			}
			"Customer"
			{
				name = "Customer"
				type = Customer_Portal
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This is the default profile having only add and view permission.\n"
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
				}
			}
	}


